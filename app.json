{
  "expo": {
    "name": "VanLink",
    "slug": "vanlink-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vanlinkllc.mobile",
      "associatedDomains": [
        "applinks:vanlink.app",
        "applinks:www.vanlink.app"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VanLink uses your location to show driver jobs near your current position."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vanlinkllc.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vanlink"
  }
}
